# Obligatorio: genera un secreto aleatorio de al menos 32 bytes.
# Usa exactamente el mismo valor en Auth-Backend (HS256); nunca en el frontend.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# URLs de los Microservicios Upstream (opcionales: por defecto usan hostnames de Docker)
AUTH_SERVICE_URL=http://host.docker.internal:4000
MENU_SERVICE_URL=http://menu-backend:8080
INVENTORY_SERVICE_URL=http://inventory-backend:3000
ORDERS_SERVICE_URL=http://orders-backend:8082
KITCHEN_SERVICE_URL=http://kitchen-backend:8086
PAYMENTS_SERVICE_URL=http://payments-backend:8084
FLOOR_SERVICE_URL=http://floor-backend:8085

